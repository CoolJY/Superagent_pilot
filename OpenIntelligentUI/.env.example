# Agent settings: place these in apps/agent/.env.
# Use the key for the selected provider; never expose keys to the browser.
# Internal deployment profile (recommended for Superagent Pilot).
AIR_GAP_MODE=true
LLM_PROVIDER=vllm
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# Must match the model name exposed by your vLLM server.
LLM_MODEL=your-served-model-name
# Optional: leave blank if the internal endpoint does not require a key.
VLLM_API_KEY=
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# Legacy cloud profile only: AIR_GAP_MODE=false, LLM_PROVIDER=auto.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# chat-latest follows ChatGPT Instant. gpt-* uses OpenAI; claude-* uses Anthropic.
# Model access/availability must be verified with your provider.
# Blank or unsupported model prefixes fail at startup.
# Keys are optional for BYOK-only hosting; visitors enter both keys in the app.
# LLM_MODEL=chat-latest

# Jev selects the renderer and visualization before each new user turn.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Frontend settings: place these in apps/app/.env.local.
# This flag must be set BEFORE building; rebuild when changing profiles.
NEXT_PUBLIC_AIR_GAP_MODE=true
NEXT_TELEMETRY_DISABLED=1
# LANGGRAPH_DEPLOYMENT_URL defaults to http://localhost:8123.
# LANGGRAPH_DEPLOYMENT_URL=http://localhost:8123
# MCP_SERVER_URL=http://localhost:3100/mcp

# Telemetry (docs/telemetry.md): anonymous install counts, on by default.
# Set either to turn it off.
DO_NOT_TRACK=1
COPILOTKIT_TELEMETRY_DISABLED=1
# OIUI_DISTRIBUTION=self_hosted
# Optional browser page analytics; leave unset unless you want them.
# NEXT_PUBLIC_POSTHOG_KEY=

# Rate limiting (per IP) — disabled by default
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=40
