# Current development provider: Gemini. Restart agent after changes.
AIR_GAP_MODE=false
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Later: AIR_GAP_MODE=true, LLM_PROVIDER=vllm, internal /v1 URL and model name.
# LLM_API_KEY may be blank only for an unauthenticated vLLM endpoint.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
DO_NOT_TRACK=1
COPILOTKIT_TELEMETRY_DISABLED=true
